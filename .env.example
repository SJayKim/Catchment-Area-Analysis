# ===================================================================
# MarketScope AI — Environment Variables
# ===================================================================
# [파일 관례]
#   .env       = 프로덕션 배포용 (prod 키 · gitignored · 서버에 rsync)
#   .env.dev   = 로컬 개발용 (dev 키 · gitignored · config.py 가 자동 우선 로드)
#   .env.e2e   = E2E 테스트용 (mock · dummy 키 · gitignored)
#   .env.example = 이 템플릿 (git 추적됨)
#
# [신규 체크아웃 플로우]
#   cp .env.example .env.dev       # 로컬 개발용
#   cp .env.example .env           # 프로덕션용 (prod 키로 교체 후 서버 배포)
#
# [배포 명령]
#   로컬 dev:  docker compose up -d              (config.py 가 .env.dev 우선 선택)
#   프로덕션:  docker compose -f docker-compose.prod.yml up -d   (.env 만 존재)
#
# [env 로딩 우선순위]
#   1. OS 환경변수 (Docker compose `environment:` 블록이 컨테이너에 주입)
#   2. pydantic settings 가 .env.dev (있으면) > .env 순으로 파일 로드
#   → 컨테이너에서는 compose env 가 우선하므로 파일 로딩은 로컬 host 전용
# ===================================================================

# Mock mode (set to true to run without DB; false uses real DB + seed data)
USE_MOCK=false

# Database (default works with docker-compose)
DATABASE_URL=postgresql+asyncpg://marketscope:devpassword@localhost:5432/marketscope
DATABASE_URL_SYNC=postgresql://marketscope:devpassword@localhost:5432/marketscope

# Redis (default works with docker-compose)
REDIS_URL=redis://localhost:6379/0

# Seoul Open Data API Key (Full ETL only, Quick Start에서는 불필요)
# 발급: https://data.seoul.go.kr → 회원가입 → 마이페이지 → 인증키 신청 (즉시 발급)
SEOUL_OPENDATA_API_KEY=your_seoul_api_key_here

# data.go.kr API Key (현재 미사용, 향후 점포이력 데이터용)
# 발급: https://www.data.go.kr → 회원가입 → 마이페이지 → 인증키 발급
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# Anthropic Claude API Key (AI 챗봇 필수)
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT API Key (AI 챗봇 — OpenAI 사용 시. 없으면 폴백 체인에서 자동 제외)
# 발급: https://platform.openai.com → API keys
OPENAI_API_KEY=your_openai_api_key_here
# 모델 ID (기본 gpt-5.4-mini). GPT-5.x reasoning 모델은 temperature 미수용이라 코드가 생략.
#OPENAI_MODEL=gpt-5.4-mini

# Langfuse (LLMOps L1 — Trace, optional)
# 발급: https://langfuse.com → 프로젝트 생성 → Settings → API Keys
# 둘 다 세팅해야 활성화. 비어있으면 tracing 비활성(서비스 동작은 영향 없음).
# ⚠ .env 에는 prod 워크스페이스 키, .env.dev 에는 dev 워크스페이스 키를 분리 저장.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud 기본값 사용. Self-host 전환 시: http://localhost:3000 등
LANGFUSE_HOST=https://cloud.langfuse.com
# Langfuse UI 의 environment 필터 — dev vs prod trace 격리로 평가/quota 혼선 방지.
# 파일별 관례: .env(프로덕션)=production / .env.dev(로컬)=development /
# e2e 스택은 docker-compose.e2e.yml 이 e2e 를 주입 (E2E_LANGFUSE_* opt-in).
LANGFUSE_TRACING_ENVIRONMENT=development
# 샘플링 비율 (1.0=100%, 0.1=10%). load-test 시 낮춰 지연 회피.
LANGFUSE_SAMPLING_RATE=1.0
# session_id 해싱 salt — 사실상 필수. 비워두면 기동 시 랜덤 생성되어 재시작마다
# 같은 세션이 다른 해시로 갈라짐 (Langfuse Sessions 뷰 분절). 파일별 고유값 권장:
#   python -c "import secrets; print(secrets.token_hex(16))"
LANGFUSE_SESSION_SALT=

# Google Gemini API Key (AI 챗봇 — Gemini 사용 시 필수)
# 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Agent / LLM 설정
# AGENT_LOOP_VERSION 이 실제 아키텍처 스위치:
#   v2  = 모델주도 function-calling 루프 + Trust Kernel (config 기본값, 현행)
#   pae = 레거시 Planner-Actor-Evaluator 그래프 (롤백 스위치)
# mock 프로바이더는 항상 PAE 폴백 (fake LLM 은 tool-call 불가).
AGENT_LOOP_VERSION=v2
# v2 budget governor — 기본값은 config.py 에 있음. 필요할 때만 주석 해제해 override.
#AGENT_LOOP_MAX_ITERATIONS=6     # 요청당 모델 턴 상한 (마지막 턴은 도구 없이 prose 강제 종결)
#AGENT_LOOP_MAX_TOOL_CALLS=12    # 요청당 도구 실행 총량 상한
#AGENT_LOOP_WALL_CLOCK=90.0      # 초 — 경과 시 강제 finalize
# v2 최종 응답 스트리밍(옵션 B) — astream 버퍼링 + "응답 작성 중 n%" 진행 이벤트.
# 본문은 Trust 검증 후 일괄 방출 (이벤트 계약/Trust 의미론 불변). false = 롤백(ainvoke).
#AGENT_LOOP_STREAM_FINAL=true
#AGENT_LOOP_PROGRESS_MIN_CHARS=120       # 진행 이벤트 최소 분량 문턱 (도구 턴 서두 오인 방지)
#AGENT_LOOP_PROGRESS_INTERVAL_CHARS=80   # 진행 이벤트 간 최소 문자 간격
#AGENT_LOOP_EXPECTED_ANSWER_CHARS=2400   # 진행률 분모 (99% cap)
# Trust Kernel — 응답 수치를 도구 반환값에 바인딩 검사하는 허용 오차 (0.05 = ±5%)
#TRUST_NUMERIC_TOLERANCE=0.05
# 선호-우선(preferred-first) 체인의 1순위 provider: anthropic / openai / gemini / mock
# 기본 체인(키 게이트) anthropic → openai → gemini_pro → gemini_flash 에서 이 값의
# provider 를 선두로 이동. 해당 키가 없으면 기본 체인 유지 + per-process 1회 경고.
LLM_PROVIDER=gemini

# Kakao Map JavaScript API Key (지도 표시 필수)
# 발급: https://developers.kakao.com → 앱 생성 → JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_key_here

# 프런트엔드 API base URL — 루트 도메인만 (슬래시/api 절대 금지)
#   올바른 예: https://marketscope.example.com
#   잘못된 예: https://marketscope.example.com/api  ← 프런트 코드가 /api를 자체 추가함
# 로컬은 http://localhost:8000, 프로덕션은 HTTPS 도메인.
# 빌드 시 이 값이 이미지에 baked-in 되므로 변경하려면 재빌드 필요.
NEXT_PUBLIC_API_URL=http://localhost:8000

# 랜딩 푸터 — Footer.tsx 가 빈 값이면 해당 li 미렌더 (graceful fallback)
# 빌드 타임 bake-in 이라 변경 시 재빌드 필요.
# GitHub 등 공개 저장소가 있으면 입력 (예: https://github.com/your-org/marketscope)
NEXT_PUBLIC_REPO_URL=
# 문의용 이메일 (mailto: 링크). 비어있으면 푸터 "문의" 미노출.
NEXT_PUBLIC_CONTACT_EMAIL=
# 카카오 채널 또는 Tally 폼 URL (피드백 보내기 링크). 둘 중 하나만 있어도 노출.
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
NEXT_PUBLIC_FEEDBACK_FORM_URL=

# Phase E.3 — 'true' 일 때만 FreeLimitSurvey Premium CTA 노출 (기본 off, 빌드 타임 bake-in)
NEXT_PUBLIC_PREMIUM_CTA_ENABLED=
