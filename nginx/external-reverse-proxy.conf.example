# MarketScope AI — External Reverse Proxy Sample
#
# 호스트 nginx(마스터 nginx)가 Let's Encrypt + 여러 서비스를 함께 서빙하는 환경용.
# docker-compose.prod.yml 은 frontend(컨테이너 내부 3000 → 호스트 3200) 만 노출하고
# backend(8000)는 호스트 nginx가 내부 네트워크로 프록시한다는 가정.
#
# 복사 위치 예: /etc/nginx/sites-available/marketscope
# 활성화:       ln -s /etc/nginx/sites-available/marketscope /etc/nginx/sites-enabled/
# 검증:         nginx -t && systemctl reload nginx
#
# 필수 포인트:
#   - /api/chat 은 SSE → proxy_buffering off, proxy_read_timeout ≥300s
#   - /api/*   는 전부 backend:8000 (Next.js server route는 /proxy/* 네임스페이스 사용)
#   - frontend(3200) 는 default location
#   - /health 는 backend 직접 노출

upstream marketscope_backend {
    server 127.0.0.1:8000;
}

upstream marketscope_frontend {
    server 127.0.0.1:3200;
}

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name marketscope.robitlabs.co.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name marketscope.robitlabs.co.kr;

    # Let's Encrypt certificates
    ssl_certificate     /etc/letsencrypt/live/marketscope.robitlabs.co.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/marketscope.robitlabs.co.kr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 10m;

    # Gzip
    gzip on;
    gzip_types text/plain application/json application/javascript text/css;
    gzip_min_length 256;
    gzip_vary on;

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- SSE endpoint: /api/chat ---
    # 버퍼링이 켜지면 첫 토큰 도달까지 수 초~수십 초 지연. 필수 off.
    location /api/chat {
        proxy_pass http://marketscope_backend;
        proxy_http_version 1.1;

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        add_header X-Accel-Buffering no always;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # --- General API: /api/ ---
    location /api/ {
        proxy_pass http://marketscope_backend;
        proxy_http_version 1.1;

        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # --- Health check ---
    location /health {
        proxy_pass http://marketscope_backend;
        proxy_http_version 1.1;

        proxy_read_timeout 5s;
        proxy_set_header Host $host;
    }

    # --- Next.js static assets (immutable) ---
    location /_next/static/ {
        proxy_pass http://marketscope_frontend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;

        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # --- Frontend (기본) — /proxy/kakao-sdk 등 Next.js server routes 포함 ---
    location / {
        proxy_pass http://marketscope_frontend;
        proxy_http_version 1.1;

        proxy_read_timeout 30s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }
}
