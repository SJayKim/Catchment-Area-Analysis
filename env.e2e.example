# env.e2e.example — E2E 회귀 테스트 전용 env 템플릿
# 사용법:
#   cp env.e2e.example .env.e2e       (실제 파일은 .env.e2e, gitignore)
#   → ANTHROPIC_API_KEY / GOOGLE_API_KEY 에 테스트 전용 키 입력
# 운영 (.env) 와 절대 공유 금지. 운영 키 실수 유입 시 preflight.sh 가 거부.

# --- 환경 프로파일 가드 ---
ENV_PROFILE=e2e
USE_MOCK=true

# --- Frontend → Backend (e2e compose 포트 8002) ---
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_KAKAO_MAP_KEY=e2edummykey

# --- LLM: 테스트 전용 키 (월 $10 상한 권장) ---
# Mock 시나리오 대부분은 intent classifier rule-path 로 LLM 호출 skip.
# Real happy-path 만 소량 호출.
ANTHROPIC_API_KEY=your_e2e_test_key_here
GOOGLE_API_KEY=your_e2e_test_key_here
LLM_PROVIDER=anthropic
# v2(기본) = function-calling 루프. PAE baseline 비교 시 pae 로 전환.
AGENT_LOOP_VERSION=v2

# --- Telemetry 전면 비활성 (운영 Langfuse / PostHog 유출 방지) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
POSTHOG_KEY=
SENTRY_DSN=

# --- E2E seed 복원은 로컬 dump 파일만 사용. 외부 API ETL 금지 ---
SEOUL_OPENDATA_API_KEY=

# --- 운영 도메인 가드 (prodGuard helper 와 매칭) ---
# 테스트 도중 아래 호스트로 요청 발생 시 prodGuard 가 abort + ProdHitLog 기록
E2E_BLOCKED_HOSTS=marketscope.robitlabs.co.kr,langfuse.com,us.i.posthog.com,sentry.io
